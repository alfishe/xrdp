Description: stage: Clear update_scheduled when the update is discarded
 Backport of upstream mutter commit 24083e1e5851a13b9d307d538d84f42091a7b220
 (mutter 48). A frame dispatched before the stage is mapped left
 update_scheduled set, so once an input device event was queued no further
 update was ever scheduled and the screen stayed black until a new window
 was mapped. Hit with xorgxrdp sessions, where the X11 stage maps after its
 virtual input devices appear. The test is adapted to mutter 46, which has
 no show-stage plugin option.
Origin: backport, https://gitlab.gnome.org/GNOME/mutter/-/commit/24083e1e5851a13b9d307d538d84f42091a7b220
Bug: https://gitlab.gnome.org/GNOME/mutter/-/issues/3804
---
--- a/clutter/clutter/clutter-stage-private.h
+++ b/clutter/clutter/clutter-stage-private.h
@@ -63,6 +63,9 @@ void                clutter_stage_emit_a
 void                clutter_stage_after_update           (ClutterStage          *stage,
                                                           ClutterStageView      *view,
                                                           ClutterFrame          *frame);
+void                clutter_stage_frame_discarded        (ClutterStage          *stage,
+                                                          ClutterStageView      *view,
+                                                          ClutterFrame          *frame);
 
 CLUTTER_EXPORT
 void                _clutter_stage_set_window            (ClutterStage          *stage,
--- a/clutter/clutter/clutter-stage-view.c
+++ b/clutter/clutter/clutter-stage-view.c
@@ -877,11 +877,12 @@ handle_frame_clock_frame (ClutterFrameCl
   if (CLUTTER_ACTOR_IN_DESTRUCTION (stage))
     return CLUTTER_FRAME_RESULT_IDLE;
 
-  if (!clutter_actor_is_realized (CLUTTER_ACTOR (stage)))
-    return CLUTTER_FRAME_RESULT_IDLE;
-
-  if (!clutter_actor_is_mapped (CLUTTER_ACTOR (stage)))
-    return CLUTTER_FRAME_RESULT_IDLE;
+  if (!clutter_actor_is_realized (CLUTTER_ACTOR (stage)) ||
+      !clutter_actor_is_mapped (CLUTTER_ACTOR (stage)))
+    {
+      clutter_stage_frame_discarded (stage, view, frame);
+      return CLUTTER_FRAME_RESULT_IDLE;
+    }
 
   if (_clutter_context_get_show_fps ())
     begin_frame_timing_measurement (view);
--- a/clutter/clutter/clutter-stage.c
+++ b/clutter/clutter/clutter-stage.c
@@ -531,6 +531,16 @@ clutter_stage_after_update (ClutterStage
   priv->update_scheduled = FALSE;
 }
 
+void
+clutter_stage_frame_discarded (ClutterStage     *stage,
+                               ClutterStageView *view,
+                               ClutterFrame     *frame)
+{
+  ClutterStagePrivate *priv = clutter_stage_get_instance_private (stage);
+
+  priv->update_scheduled = FALSE;
+}
+
 static gboolean
 clutter_stage_get_paint_volume (ClutterActor *self,
                                 ClutterPaintVolume *volume)
